# Firebase (required) — from Firebase Console → Project settings → Your apps
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
# Firebase Storage (optional — Blaze plan only)
# The bucket value is in your Firebase web app config, but Storage uploads are OFF by default.
# Without Storage, small PDFs are stored inline in Firestore (~900KB max per file).
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_USE_FIREBASE_STORAGE=true

# Optional: enable maintenance image uploads via data URLs (Spark plan)
# VITE_ENABLE_FILE_UPLOAD=true
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Payments: paymongo-simulated (default) | paymongo (real API) | demo (instant, no redirect)
VITE_PAYMENT_GATEWAY=paymongo-simulated

# PayMongo real API (only when VITE_PAYMENT_GATEWAY=paymongo)
# VITE_PAYMONGO_API_URL=/.netlify/functions/paymongo-checkout
# Netlify secrets: PAYMONGO_SECRET_KEY, PAYMONGO_WEBHOOK_SECRET, FIREBASE_SERVICE_ACCOUNT_JSON

# Seed script only (do not commit serviceAccountKey.json)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=your_project_id

# Company branding (used on invoice PDFs and report exports)
VITE_COMPANY_NAME=SmartLease Property Management
VITE_COMPANY_ADDRESS=123 Property Lane, Metro Manila, Philippines
VITE_COMPANY_PHONE=+63 912 345 6789
VITE_COMPANY_EMAIL=billing@smartlease.ph
VITE_PAYMENT_INSTRUCTIONS=Please remit payment via bank transfer to BDO Account #1234567890 (SmartLease PM) or GCash 09123456789. Include your invoice number as payment reference.
# Dashboard: https://dashboard.emailjs.com — create a service, template, and copy the public key.
# Template variables (must match your EmailJS template):
#   {{to_email}}  — recipient address (set as "To Email" in template settings)
#   {{to_name}}   — recipient display name
#   {{subject}}   — email subject line
#   {{message}}   — email body (plain text or HTML per your template)
VITE_EMAILJS_SERVICE_ID=service_q2fgrs8
VITE_EMAILJS_TEMPLATE_ID=template_jkna7s6
VITE_EMAILJS_PUBLIC_KEY=O1NLOTSvP043z_Obv
# Optional: separate admin template (unused by default; tenant template handles all events)
# VITE_EMAILJS_TEMPLATE_ADMIN_ID=your_admin_template_id
